@ Generated by tools/gym_hack/build_training_houses.py: the post-game training trainers.
@ They battle as often as the player likes (their trainer flag is cleared first), with no type rule.

TrainingHouse_EventScript_Morris::
	lock
	faceplayer
	msgbox TrainingHouse_Text_MorrisIntro, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, TrainingHouse_EventScript_Declined
	cleartrainerflag TRAINER_TRAINING_MORRIS
	trainerbattle_no_intro TRAINER_TRAINING_MORRIS, TrainingHouse_Text_Defeat
	msgbox TrainingHouse_Text_After
	release
	end

